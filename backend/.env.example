CHAT_MODEL_PROVIDER=ollama
CHAT_MODEL_NAME=qwen3.5:2b
CHAT_TEMPERATURE=0
CHAT_MAX_TOKENS=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_GPU=1
OLLAMA_NUM_THREAD=4
OLLAMA_LOW_VRAM=true

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL_NAME=nomic-embed-text

DASHSCOPE_API_KEY=sk-
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

KB_INDEX_PATH=
KB_SOURCE_DIR=
AUTO_REBUILD_KB_ON_STARTUP=false

KB_VECTOR_BACKEND=chroma
CHROMA_COLLECTION_NAME=knowledge_base
CHROMA_PERSIST_DIR=

KB_RERANK_ENABLED=true
KB_RERANK_BACKEND=scoring
KB_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-2-v2

SESSION_MEMORY_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SESSION_PREFIX=dataagent:chat:session:
REDIS_SESSION_TTL_SECONDS=86400
MAX_SESSION_MESSAGES=16

STREAM_CHUNK_SIZE=24
STREAM_CHUNK_DELAY=0.01

MCP_ENABLED=true
MCP_TOOL_MODE=append
MCP_SERVER_NAME=primary
MCP_SERVER_TRANSPORT=streamable_http
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
MCP_SERVER_COMMAND=
MCP_SERVER_ARGS=[]
MCP_TOOL_ALLOWLIST=
