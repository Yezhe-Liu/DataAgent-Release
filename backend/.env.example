# ===== 聊天模型 (默认: DeepSeek V4 双模型) =====
# provider: deepseek / vllm / dashscope / ollama
CHAT_MODEL_PROVIDER=deepseek
CHAT_MODEL_NAME=deepseek-v4-flash
CHAT_MODEL_PRO=deepseek-v4-pro
CHAT_TEMPERATURE=0
CHAT_MAX_TOKENS=2000

# ===== DeepSeek API (provider=deepseek 时必填) =====
# 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===== vLLM 自部署推理 (provider=vllm 时使用) =====
# 启动命令: vllm serve <model> --enable-prefix-caching --port 8000
# VLLM_BASE_URL=http://localhost:8000/v1

# ===== DashScope API (provider=dashscope 时使用) =====
# 获取地址: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== Embedding 模型 =====
# DeepSeek 不提供 Embedding API, 建议用本地 Ollama (免费) 或 DashScope
# Ollama 不可用时 rag_engine 会自动回退到 hash 向量
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL_NAME=nomic-embed-text

# ===== Ollama (embedding / 本地推理时使用) =====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_GPU=1
OLLAMA_NUM_THREAD=4
OLLAMA_LOW_VRAM=true

# ===== 知识库 =====
KB_INDEX_PATH=
KB_SOURCE_DIR=
AUTO_REBUILD_KB_ON_STARTUP=false

KB_VECTOR_BACKEND=chroma
CHROMA_COLLECTION_NAME=knowledge_base
CHROMA_PERSIST_DIR=

KB_RERANK_ENABLED=true
KB_RERANK_BACKEND=scoring
KB_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-2-v2

# ===== 会话记忆 =====
SESSION_MEMORY_BACKEND=memory
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SESSION_PREFIX=dataagent:chat:session:
REDIS_SESSION_TTL_SECONDS=86400
MAX_SESSION_MESSAGES=16

# ===== MCP 工具源 =====
# 用法1: stdio 本地 MCP Server (推荐)
#   MCP_ENABLED=true
#   MCP_SERVER_TRANSPORT=stdio
#   MCP_SERVER_COMMAND=uv
#   MCP_SERVER_ARGS=["run","python","-m","src.mcp_server"]
#
# 用法2: 远程 HTTP MCP Server
#   MCP_ENABLED=true
#   MCP_SERVER_TRANSPORT=streamable_http
#   MCP_SERVER_URL=http://127.0.0.1:8000/mcp
MCP_ENABLED=false
MCP_TOOL_MODE=append
MCP_SERVER_NAME=primary
MCP_SERVER_TRANSPORT=streamable_http
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
MCP_SERVER_COMMAND=
MCP_SERVER_ARGS=[]
MCP_TOOL_ALLOWLIST=

# ===== MCP 电信气象数据库 (SQLite 只读) =====
TELECOM_SQLITE_PATH=backend/data/telecom_propagation.db
TELECOM_DB_MAX_ROWS=500